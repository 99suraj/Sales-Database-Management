 --Find The Total No of products Sold By each Customers 
 
select 
c.customer_name, 
sum(s.quantity) as Totalsale 
from sales1 as s 
join customer1 as c 
on c.customer_id= s.customer_id 
group by c.customer_name;

 --Find the Total Revenue Generated By Each customers. 
 
 
select 
c.customer_name, 
sum(p.price) as Total_revenue 
from sales1 as s 
join customer1 as c 
on s.customer_id= c.customer_id 
join products1 as p 
on s.product_id= p.productid 
group by c.customer_name;

 --Find the Total sale amount -- 
 
select 
c.customer_name, 
sum(p.price * s.quantity) as Total_sale_amount 
from sales1 as s 
join customer1 as c 
on s.customer_id=c.customer_id 
join products1 as p 
on s.product_id=p.productid 
group by c.customer_name; 
 
 
 --find the best-selling product(the one with the highest total sales quantity) -- 
 
select 
  p.product_name, 
  sum(s.quantity) as Total_quantity_sold 
  from sales1 as s 
  join products1 as p 
  on s.product_id=p.productid 
group by product_name 
order by Total_quantity_sold desc 


 --Find the customers who bought the most Products. --
 
SELECT 
    c.customer_name, 
    COUNT(s.sales_id) AS total_purchases
FROM sales1 AS s
JOIN customer1 AS c 
    ON s.customer_id = c.customer_id
GROUP BY c.customer_name
ORDER BY total_purchases DESC
LIMIT 1;



 --total number of sales per product ---
 
select 
  p.product_name, 
  count(s.sales_id) as total_no_sales 
  from sales1 s 
  join products1 p 
  on s.product_id = p.productid 
group by p.product_name; 


 --List all customers who brought more than 2 products.---- 
 
select 
  c.customer_name, 
  count(s.sales_id) total_prdoucts 
  from sales1 s 
  join customer1 c 
  on s.customer_id= c.customer_id 
group by c.customer_name 
having count(s.sales_id)>1;

 --Find top best-selling products ---
 
SELECT 
    p.product_name, 
    COUNT(s.sales_id) AS total_sales_of_products
FROM sales1 AS s
JOIN products1 AS p 
    ON s.product_id = p.productid   -- change this if your column is product_id
GROUP BY p.product_name
ORDER BY total_sales_of_products DESC
LIMIT 3;



